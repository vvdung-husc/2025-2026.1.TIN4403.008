<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2FA"
    tools:context=".UserActivity">

    <!-- ===== PROFILE HEADER ===== -->

    <TextView
        android:id="@+id/txtFullname"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Xin chào: User"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3F3D56"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtEmail"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Email: example@gmail.com"
        android:textColor="#6D6A7C"
        app:layout_constraintTop_toBottomOf="@id/txtFullname"
        app:layout_constraintStart_toStartOf="@id/txtFullname" />

    <!-- ===== UPDATE FORM ===== -->

    <TextView
        android:id="@+id/txtNewFullname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Họ và tên mới"
        android:textStyle="bold"
        android:textColor="#3F3D56"
        app:layout_constraintTop_toBottomOf="@id/txtEmail"
        app:layout_constraintStart_toStartOf="@id/txtEmail" />

    <EditText
        android:id="@+id/edtNewFullname"
        android:layout_width="290dp"
        android:layout_height="44dp"
        android:hint="Nhập họ và tên"
        android:inputType="textPersonName"
        android:padding="10dp"
        android:backgroundTint="#8E7CC3"
        app:layout_constraintTop_toBottomOf="@id/txtNewFullname"
        app:layout_constraintStart_toStartOf="@id/txtNewFullname" />

    <TextView
        android:id="@+id/txtNewEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Email mới"
        android:textStyle="bold"
        android:textColor="#3F3D56"
        app:layout_constraintTop_toBottomOf="@id/edtNewFullname"
        app:layout_constraintStart_toStartOf="@id/edtNewFullname" />

    <EditText
        android:id="@+id/edtNewEmail"
        android:layout_width="290dp"
        android:layout_height="44dp"
        android:hint="Nhập email"
        android:inputType="textEmailAddress"
        android:padding="10dp"
        android:backgroundTint="#8E7CC3"
        app:layout_constraintTop_toBottomOf="@id/txtNewEmail"
        app:layout_constraintStart_toStartOf="@id/txtNewEmail" />

    <TextView
        android:id="@+id/txtNewPassword1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Mật khẩu mới"
        android:textStyle="bold"
        android:textColor="#3F3D56"
        app:layout_constraintTop_toBottomOf="@id/edtNewEmail"
        app:layout_constraintStart_toStartOf="@id/edtNewEmail" />

    <EditText
        android:id="@+id/edtPassword1"
        android:layout_width="290dp"
        android:layout_height="44dp"
        android:hint="Nhập mật khẩu"
        android:inputType="textPassword"
        android:padding="10dp"
        android:backgroundTint="#8E7CC3"
        app:layout_constraintTop_toBottomOf="@id/txtNewPassword1"
        app:layout_constraintStart_toStartOf="@id/txtNewPassword1" />

    <TextView
        android:id="@+id/txtNewPassword2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Nhập lại mật khẩu"
        android:textStyle="bold"
        android:textColor="#3F3D56"
        app:layout_constraintTop_toBottomOf="@id/edtPassword1"
        app:layout_constraintStart_toStartOf="@id/edtPassword1" />

    <EditText
        android:id="@+id/edtPassword2"
        android:layout_width="290dp"
        android:layout_height="44dp"
        android:hint="Xác nhận mật khẩu"
        android:inputType="textPassword"
        android:padding="10dp"
        android:backgroundTint="#8E7CC3"
        app:layout_constraintTop_toBottomOf="@id/txtNewPassword2"
        app:layout_constraintStart_toStartOf="@id/txtNewPassword2" />

    <!-- ===== ACTION BUTTONS ===== -->

    <Button
        android:id="@+id/btnUpdate"
        android:layout_width="290dp"
        android:layout_height="48dp"
        android:layout_marginTop="22dp"
        android:text="Cập nhật thông tin"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#6A5AAE"
        app:layout_constraintTop_toBottomOf="@id/edtPassword2"
        app:layout_constraintStart_toStartOf="@id/edtPassword2" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="290dp"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:text="Đăng xuất"
        android:textAllCaps="false"
        android:textColor="#6A5AAE"
        android:backgroundTint="#EDE7F6"
        app:layout_constraintTop_toBottomOf="@id/btnUpdate"
        app:layout_constraintStart_toStartOf="@id/btnUpdate" />

</androidx.constraintlayout.widget.ConstraintLayout>
